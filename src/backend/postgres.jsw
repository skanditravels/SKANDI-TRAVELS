import { currentMember } from 'wix-members-backend';
import { findAgentByMemberOrEmail, publicAgent } from './RIA/staffPortalAuth.repository.js';

// Legacy .jsw compatibility adapter. Operational data remains in Supabase,
// never Wix CMS or a browser-side SQL client.
export async function getAgentProfile() {
  const member = await currentMember.getMember({ fieldsets: ['FULL'] }).catch(() => null);
  if (!member) throw new Error('STAFF_LOGIN_REQUIRED');
  const agent = await findAgentByMemberOrEmail({
    memberId: member._id || member.id || '',
    email: member.loginEmail || member.email || member.contactDetails?.emails?.[0] || '',
  });
  if (!agent) throw new Error('STAFF_PROFILE_NOT_FOUND');
  const profile = publicAgent(agent);
  return {
    first_name: profile.firstName || '',
    last_name: profile.lastName || '',
    skID: profile.skId || '',
    image_url: profile.profileImageUrl || '',
  };
}
