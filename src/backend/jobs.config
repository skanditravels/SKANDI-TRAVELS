{
      "function": "/homepageWorker.jsw/refreshHomepagePrices",
      "description": "Aggregates Duffel flight fares with Supabase charter assets and caches the total",
      "executionConfig": {
        "cronExpression": "0 2 * * *" 
      }
    }
  ]
}
